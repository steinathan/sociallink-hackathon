rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Public avatar images ─────────────────────────────────────────────────
    match /avatars/{uid}/{allPaths=**} {
      // Anyone can read avatars
      allow read: if true;
      // Only the owner can upload their own avatar
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024 // max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Chat images ──────────────────────────────────────────────────────────
    match /chats/{chatId}/{allPaths=**} {
      // Any authenticated user can upload chat images
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Any authenticated user can read chat images
      allow read: if request.auth != null;
    }

    // ─── Dispute evidence ─────────────────────────────────────────────────────
    match /disputes/{bookingId}/{allPaths=**} {
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Only authenticated users can read (admin will have Admin SDK access)
      allow read: if request.auth != null;
    }

    // ─── Gallery images (consultant public profile) ───────────────────────────
    match /gallery/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
